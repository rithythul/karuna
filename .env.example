KARUNA_DATABASE_URL=postgresql://karuna:karuna@localhost:5432/karuna
KARUNA_REDIS_URL=redis://localhost:6379
KARUNA_OPENROUTER_API_KEY=sk-or-v1-your-key-here
KARUNA_HOST=0.0.0.0
KARUNA_PORT=8000
KARUNA_DEFAULT_MODEL=anthropic/claude-sonnet-4
KARUNA_PLANNING_MODEL=anthropic/claude-sonnet-4
KARUNA_FAST_MODEL=anthropic/claude-haiku-4
KARUNA_SANDBOX_IMAGE=karuna-sandbox:latest
KARUNA_SANDBOX_MEMORY_MB=512
KARUNA_SANDBOX_CPU_QUOTA=50000

# KOOMPI KID OAuth (https://dash.koompi.org)
KARUNA_KOOMPI_CLIENT_ID=your-client-id
KARUNA_KOOMPI_CLIENT_SECRET=your-client-secret
KARUNA_PUBLIC_URL=http://localhost:3000
