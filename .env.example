HANUMAN_DATABASE_URL=postgresql://hanuman:hanuman@localhost:5432/hanuman
HANUMAN_REDIS_URL=redis://localhost:6379
HANUMAN_OPENROUTER_API_KEY=sk-or-v1-your-key-here
HANUMAN_HOST=0.0.0.0
HANUMAN_PORT=8000
HANUMAN_DEFAULT_MODEL=anthropic/claude-sonnet-4
HANUMAN_PLANNING_MODEL=anthropic/claude-sonnet-4
HANUMAN_FAST_MODEL=anthropic/claude-haiku-4
HANUMAN_SANDBOX_IMAGE=hanuman-sandbox:latest
HANUMAN_SANDBOX_MEMORY_MB=512
HANUMAN_SANDBOX_CPU_QUOTA=50000

# Development mode (enables dev-seed auth, permissive CORS, no Secure cookie flag)
HANUMAN_DEV_MODE=true

# KOOMPI KID OAuth (https://dash.koompi.org)
HANUMAN_KOOMPI_CLIENT_ID=your-client-id
HANUMAN_KOOMPI_CLIENT_SECRET=your-client-secret
HANUMAN_PUBLIC_URL=http://localhost:3000
